# DCP Service Configuration

# Gateway URL
DCP_INTERNAL_GATEWAY_URL=http://localhost

# Security
DCP_VERIFY_SSL=true

# Authentication
DCP_CLIENT_ID=your-client-id
DCP_CLIENT_SECRET=your-client-secret
DCP_JWT_TOKEN=your-jwt-secret-key-must-be-long-enough

# Optional
DCP_CORE_KEY=your-core-key

# User Token
DCP_USER_ID=your-user-id
DCP_USER_TOKEN=your-user-token